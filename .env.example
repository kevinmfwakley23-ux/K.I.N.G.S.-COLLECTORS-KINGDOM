KINGDOM_HOST=127.0.0.1
KINGDOM_PORT=8788
KINGDOM_LOG_LEVEL=info
KINGDOM_VERSION=0.2.0
KINGDOM_DATA_DIR=./data
KINGDOM_SESSION_TTL_HOURS=168
KINGDOM_COOKIE_SECURE=false

# Shared K.I.N.G.S. AI router. Provider credentials stay server-side.
KINGDOM_KINGS_AI_BASE_URL=http://127.0.0.1:8790
KINGDOM_KINGS_AI_TOKEN=
KINGDOM_KINGS_AI_TIMEOUT_MS=70000

# Provider-neutral catalog and verification evidence. Contact email is used where provider etiquette supports it.
KINGDOM_CATALOG_CONTACT_EMAIL=
KINGDOM_CATALOG_TIMEOUT_MS=5000
KINGDOM_CATALOG_CACHE_TTL_MS=21600000
KINGDOM_CATALOG_CACHE_ENTRIES=500
KINGDOM_CATALOG_MIN_INTERVAL_MS=1100

# Open Library ISBN evidence.
KINGDOM_OPEN_LIBRARY_BASE_URL=https://openlibrary.org

# UPCitemdb retail-code evidence. Optional paid key remains server-only.
KINGDOM_UPCITEMDB_BASE_URL=https://api.upcitemdb.com
KINGDOM_UPCITEMDB_USER_KEY=
KINGDOM_UPCITEMDB_TIMEOUT_MS=5000
KINGDOM_UPCITEMDB_MIN_INTERVAL_MS=10000

# Pokémon TCG exact-card evidence. Optional key remains server-only.
KINGDOM_POKEMON_TCG_BASE_URL=https://api.pokemontcg.io
KINGDOM_POKEMON_TCG_API_KEY=
KINGDOM_POKEMON_TCG_TIMEOUT_MS=5000
KINGDOM_POKEMON_TCG_MIN_INTERVAL_MS=5000

# Magic: The Gathering exact-printing evidence via Scryfall.
# 150 ms is the Kingdom's conservative internal spacing below Scryfall's published <10 req/s guidance.
KINGDOM_SCRYFALL_BASE_URL=https://api.scryfall.com
KINGDOM_SCRYFALL_TIMEOUT_MS=5000
KINGDOM_SCRYFALL_MIN_INTERVAL_MS=150

# PSA certification-database evidence. Generate API access through PSA and keep the token server-side.
# A database match confirms provider data associated with a cert number; it does not prove the physical holder/item is genuine.
KINGDOM_PSA_BASE_URL=https://api.psacard.com/publicapi
KINGDOM_PSA_ACCESS_TOKEN=
KINGDOM_PSA_TIMEOUT_MS=5000
KINGDOM_PSA_MIN_INTERVAL_MS=1000

# Sports-card catalog identity evidence via The Card API.
# Catalog access requires an eligible paid Catalog API plan/add-on for production commercial use; the API key stays server-only.
# This path intentionally uses catalog identity only. Market/sales endpoints and price data are not part of IMP-005 sports-card identification.
KINGDOM_CARD_API_BASE_URL=https://www.thecardapi.com/api/v1
KINGDOM_CARD_API_KEY=
KINGDOM_CARD_API_TIMEOUT_MS=5000
KINGDOM_CARD_API_MIN_INTERVAL_MS=250
